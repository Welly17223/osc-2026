#![allow(clippy::while_immutable_condition)]

extern crate alloc;

use spin::RwLock;

use crate::{
    interrupt::{self, SModeInterrupt, SetStatusSUM, plic},
    schedule::{current_state, get_process_ready_queue_mut, schedule},
    thread::{self, State, ThreadQueue},
    virtual_mem::{self, phy_to_virt},
};
use core::{
    fmt::Write,
    ptr,
    sync::atomic::{AtomicUsize, Ordering},
};

pub const LSR_DR: u8 = 1 << 0;
pub const LSR_TDRQ: u8 = 1 << 5;

enum Offset {
    Ier,
    Iir,
    Mcr,
    Lsr,
    Rbr,
    Thr,
}

impl From<Offset> for u8 {
    fn from(value: Offset) -> Self {
        match value {
            Offset::Rbr | Offset::Thr => 0x0,
            Offset::Ier => 0x1,
            Offset::Iir => 0x2,
            Offset::Mcr => 0x4,
            Offset::Lsr => 0x5,
        }
    }
}

impl From<Offset> for usize {
    fn from(value: Offset) -> Self {
        match value {
            Offset::Rbr | Offset::Thr => 0x0,
            Offset::Ier => 0x1,
            Offset::Iir => 0x2,
            Offset::Mcr => 0x4,
            Offset::Lsr => 0x5,
        }
    }
}

pub static mut SERIAL: Option<Uart> = None;
pub static mut RX_THREAD_QUEUE: Option<thread::WaitQueue> = None;
pub static mut TX_THREAD_QUEUE: Option<thread::WaitQueue> = None;

fn get_rx_thread_queue() -> &'static mut thread::WaitQueue {
    match unsafe { &mut *(&raw mut RX_THREAD_QUEUE) } {
        Some(t) => t,
        None => panic!("Not initialize"),
    }
}

fn get_tx_thread_queue() -> &'static mut thread::WaitQueue {
    match unsafe { &mut *(&raw mut TX_THREAD_QUEUE) } {
        Some(t) => t,
        None => panic!("Not initialize"),
    }
}

pub fn get_serial() -> &'static mut Uart {
    let serial_ptr = &raw mut SERIAL;
    match unsafe { &mut *serial_ptr }.as_mut() {
        Some(s) => s,
        None => panic!("Not initialize"),
    }
}

pub struct Interrupt;
pub enum IirIse {
    ModemStatus,
    TxFIFOReqData,
    RxDataAvali,
    RxError,
}

impl TryFrom<usize> for IirIse {
    type Error = ();
    fn try_from(value: usize) -> Result<Self, Self::Error> {
        match value {
            0 => Ok(Self::ModemStatus),
            1 => Ok(Self::TxFIFOReqData),
            2 => Ok(Self::RxDataAvali),
            3 => Ok(Self::RxError),
            _ => Err(()),
        }
    }
}

impl From<IirIse> for usize {
    fn from(value: IirIse) -> Self {
        match value {
            IirIse::ModemStatus => 0,
            IirIse::TxFIFOReqData => 1,
            IirIse::RxDataAvali => 2,
            IirIse::RxError => 3,
        }
    }
}

impl interrupt::InterruptTrait for Interrupt {
    type InterruptEnum = IirIse;
    fn handler(_regs: &mut interrupt::pt_regs, interrupt_state: Option<Self::InterruptEnum>) {
        let Some(interrupt_state) = interrupt_state else {
            return;
        };
        let serial = get_serial();

        match interrupt_state {
            IirIse::TxFIFOReqData => serial.tx_interrupt(),
            IirIse::RxDataAvali => serial.push_rx(serial.read_lsr() as u8),
            IirIse::ModemStatus | IirIse::RxError => {}
        }
    }
}

pub fn init_serial(dtb_addr: *const u8) {
    use crate::fdt;
    let offset_soc_serial = match fdt::path_offset(dtb_addr, "/soc/serial", 1) {
        Ok(o) => o,
        Err(_) => return,
    };
    let uart_shift = match fdt::getprop(dtb_addr, offset_soc_serial, "reg-shift") {
        Ok((ptr, _)) => unsafe { *(ptr as *const u32) }.swap_bytes(),
        Err(fdt::Error::Notfound) => 0,
        Err(_) => panic!("Error find reg-shift"),
    };
    let (reg_ptr, _) = match fdt::getprop(dtb_addr, offset_soc_serial, "reg") {
        Ok(prop) => (prop.0 as *mut u32, prop.1),
        Err(_) => return,
    };

    let uart_base = unsafe { *reg_ptr.wrapping_offset(1) }.swap_bytes() as usize;
    let uart_compatible = match fdt::getprop(dtb_addr, offset_soc_serial, "compatible") {
        Ok((ptr, size)) => {
            let u8_list = unsafe { &*ptr::slice_from_raw_parts(ptr, size) };
            unsafe { str::from_utf8_unchecked(u8_list) }
        }
        Err(_) => "",
    };
    let uart_irq = match fdt::getprop(dtb_addr, offset_soc_serial, "interrupts") {
        Ok((ptr, _len)) => unsafe { *(ptr as *const u32) }.swap_bytes(),
        Err(_) => todo!(),
    };
    let uart_virt_base = virtual_mem::io_remap(uart_base, 4096);
    let def_uart = match uart_compatible {
        // Qemu
        s if s.contains("ns16550a") || s.contains("pxa-uart") => {
            Uart::new(uart_virt_base, uart_shift)
        }
        _ => unimplemented!(),
    };

    let Some(table) = &mut *crate::interrupt::IRQ_TABLE.write() else {
        return;
    };
    let _ = table.insert(uart_irq, crate::interrupt::plic::IRQ::UART);

    unsafe {
        SERIAL = Some(def_uart);
        RX_THREAD_QUEUE = Some(thread::WaitQueue::default());
        TX_THREAD_QUEUE = Some(thread::WaitQueue::default());
    }
}

const RING_BUF_SIZE: usize = 128;
struct RingBuf {
    output_queue: [u8; RING_BUF_SIZE],
    head: AtomicUsize,
    tail: AtomicUsize,
    size: AtomicUsize,
}

impl Default for RingBuf {
    fn default() -> Self {
        Self::new()
    }
}

impl RingBuf {
    fn push_ch<T: Into<u8>>(&mut self, ch: T) {
        let ch = ch.into();
        if self.size.load(Ordering::Relaxed) < self.output_queue.len() {
            let tail = self.tail.load(Ordering::Relaxed);
            self.output_queue[tail] = ch;
            self.tail.store(
                (tail + 1) & (self.output_queue.len() - 1),
                Ordering::Relaxed,
            );
            self.size.fetch_add(1, Ordering::Relaxed);
        }
    }

    fn pop(&mut self) -> Option<u8> {
        if self.size.load(Ordering::SeqCst) > 0 {
            let head = self.head.load(Ordering::Relaxed);
            let ch = self.output_queue[head];
            self.head.store(
                (head + 1) & (self.output_queue.len() - 1),
                Ordering::Relaxed,
            );
            self.size.fetch_sub(1, Ordering::Relaxed);
            Some(ch)
        } else {
            None
        }
    }

    fn is_empty(&self) -> bool {
        self.size.load(Ordering::Relaxed) == 0
    }

    fn is_full(&self) -> bool {
        self.size.load(Ordering::Relaxed) >= self.output_queue.len()
    }

    const fn new() -> Self {
        Self {
            output_queue: [0; RING_BUF_SIZE],
            head: AtomicUsize::new(0),
            tail: AtomicUsize::new(0),
            size: AtomicUsize::new(0),
        }
    }
}

pub struct Uart {
    base_addr: *const u8,
    register_shift: u32,
    rx_queue: RwLock<RingBuf>,
    tx_queue: RwLock<RingBuf>,
    is_async: bool,
}

unsafe impl Send for Uart {}
unsafe impl Sync for Uart {}

impl Write for Uart {
    fn write_str(&mut self, s: &str) -> core::fmt::Result {
        if self.is_async() {
            let _disable_interrupt = interrupt::SModeInterrupt::new();
            self.push_tx(s.as_bytes());
        } else {
            self.puts(s);
        }
        Ok(())
    }
}

impl crate::file_system::byte_device::ByteDevice for Uart {
    fn read(&self, _offset: u64, buf: &mut [u8]) -> Result<usize, crate::file_system::VfsError> {
        for i in buf.iter_mut() {
            let result = self.pop_rx() as _;
            let _set_sstatus_sum = SetStatusSUM::new();
            *i = result;
        }
        Ok(buf.len())
    }

    fn write(&self, _offset: u64, buf: &[u8]) -> Result<usize, crate::file_system::VfsError> {
        self.push_tx(buf);
        Ok(buf.len())
    }
}

macro_rules! gen_reg_mut_methods {
    ($(($reg:ident, $func:ident)),* $(,)?) => {
        $(
            #[inline]
            fn $func(&self) -> *mut u8 {
                let offset: usize = Offset::$reg.into();
                self.base_addr.wrapping_byte_add(offset << self.register_shift) as *mut u8
            }
        )*
    };
}

macro_rules! gen_reg_methods {
    ($(( $reg:ident, $func:ident )),* $(,)?) => {
        $(
            #[inline]
            fn $func(&self) -> *const u8 {
                let offset: usize = Offset::$reg.into();
                self.base_addr.wrapping_byte_add(offset << self.register_shift)
            }
        )*
    };
}

impl Uart {
    pub fn new(base_addr: usize, register_shift: u32) -> Self {
        let base_addr = base_addr as *const u8;
        Uart {
            base_addr,
            register_shift,
            rx_queue: RwLock::default(),
            tx_queue: RwLock::default(),
            is_async: false,
        }
    }

    pub fn disable_interrupt(&mut self) {
        self.is_async = false;
    }

    gen_reg_methods!((Lsr, lsr), (Rbr, rbr), (Iir, iir));
    gen_reg_mut_methods!((Thr, thr), (Ier, ier), (Mcr, mcr));

    // This will set read and write buffer!
    pub fn set_interrupt(&mut self, hart_id: usize) {
        use core::arch::asm;
        unsafe {
            let (mut ier, mut mcr) = if self.register_shift == 0 {
                (
                    self.ier().read_volatile() as u32,
                    self.mcr().read_volatile() as u32,
                )
            } else {
                (
                    (self.ier() as *const u32).read_volatile(),
                    (self.mcr() as *const u32).read_volatile(),
                )
            };

            ier |= 0b01;
            mcr |= 1 << 3;

            if self.register_shift == 0 {
                self.ier().write_volatile(ier as u8);
                self.mcr().write_volatile(mcr as u8);
            } else {
                (self.ier() as *mut u32).write_volatile(ier);
                (self.mcr() as *mut u32).write_volatile(mcr);
            }
        }

        let uart_irq = if let Some(irq_table) = &*interrupt::IRQ_TABLE.read() {
            let Some((res, _)) = irq_table.iter().find(|(_, irq)| **irq == plic::IRQ::UART) else {
                return;
            };
            *res
        } else {
            return;
        };
        writeln!(self, "uart_irq: {:#x}", uart_irq).unwrap();

        let hart0_plic = &raw const interrupt::plic::HART0_PLIC;
        if let Some(plic) = unsafe { &*hart0_plic } {
            writeln!(
                self,
                "set uart irq priority: [{}], {} bits at base: {:#x}",
                uart_irq >> 5,
                uart_irq & 0x1f,
                plic.get_base()
            )
            .unwrap();

            plic.set_priority(uart_irq, 0x2);
            plic.enable(hart_id, uart_irq as usize);
        }

        self.rx_queue = RwLock::default();
        self.tx_queue = RwLock::default();

        self.is_async = true;
        unsafe {
            asm!("fence io, io", "fence.i");
        }
        self.puts("End interrupt setup");
    }

    pub fn is_async(&self) -> bool {
        self.is_async
    }

    pub fn push_tx<T: AsRef<[u8]>>(&self, s: T) {
        let _disable_interrupt = SModeInterrupt::new();
        unsafe {
            let mut ier = self.ier().read_volatile();
            ier |= 0b10;
            self.ier().write_volatile(ier);
        };
        s.as_ref().iter().for_each(|i| {
            if *i == b'\n' {
                self.push_tx_ch(b'\r');
            }
            self.push_tx_ch(*i);
        });
    }

    fn push_tx_ch(&self, s: u8) {
        // set tx interrupt up
        let _disable_interrupt = SModeInterrupt::new();
        unsafe {
            let mut ier = self.ier().read_volatile();
            ier |= 0b10;
            self.ier().write_volatile(ier);
        };

        loop {
            let txq = &mut self.tx_queue.read();
            if txq.is_full() {
                drop(txq);
                if current_state() == State::Running {
                    get_tx_thread_queue().push_current();
                }
                schedule();
            } else if s == b'\n' {
                let mut txq = self.tx_queue.write();
                txq.push_ch(b'\r');
            } else {
                break;
            }
        }

        let mut txq = self.tx_queue.write();
        if s == b'\n' {
            txq.push_ch(b'\r');
        }
        txq.push_ch(s);
    }

    pub fn tx_interrupt(&mut self) {
        let _disable_interrupt = SModeInterrupt::new();
        if let Some(ch) = self.pop_tx() {
            self.write_thr(ch);
        }
    }

    pub fn pop_tx(&mut self) -> Option<u8> {
        let mut txq = self.tx_queue.write();
        let res = txq.pop();

        if let Some(entry_arc) = get_tx_thread_queue().pop() {
            let entry_lock = entry_arc.lock();
            let entry = entry_lock.get_mut();
            if entry.state == State::Waiting {
                entry.state = State::Ready;
            }
            drop(entry_lock);

            get_process_ready_queue_mut().push_back(entry_arc);
        } else if txq.is_empty() {
            unsafe { *self.ier() &= !0b10 };
        }
        res
    }

    pub fn push_rx(&mut self, c: u8) {
        let _disable_interrupt = SModeInterrupt::new();
        let mut rxq = self.rx_queue.write();
        rxq.push_ch(c);

        if let Some(entry_arc) = get_rx_thread_queue().pop() {
            let entry_lock = entry_arc.lock();
            let entry = entry_lock.get_mut();
            if entry.state == State::Waiting {
                entry.state = State::Ready;
            }

            drop(entry_lock);
            get_process_ready_queue_mut().push_back(entry_arc);
        }
    }

    pub fn get_iir(&self) -> u8 {
        unsafe { *self.iir() }
    }

    pub fn pop_rx(&self) -> u8 {
        let _disable_interrupt = SModeInterrupt::new();
        loop {
            match self.pop_rx_ch() {
                None => {
                    if current_state() == State::Running {
                        get_rx_thread_queue().push_current();
                    }
                    schedule();
                }
                Some(c) => return c,
            }
        }
    }

    pub fn pop_rx_ch(&self) -> Option<u8> {
        let _disable_interrupt = SModeInterrupt::new();
        let mut rxq = self.rx_queue.write();
        rxq.pop()
    }

    pub fn rx_queue_empty(&self) -> bool {
        let rxq = self.rx_queue.write();
        rxq.is_empty()
    }

    pub fn write_thr(&mut self, ch: u8) {
        unsafe { self.thr().write_volatile(ch) };
    }

    pub fn read_lsr(&self) -> u64 {
        unsafe { self.rbr().read_volatile() as u64 }
    }

    pub fn getc(&self) -> u64 {
        while unsafe { self.lsr().read_volatile() } & LSR_DR == 0 {}
        let ch: u64 = unsafe { self.rbr().read_volatile() } as u64;
        if ch == '\r' as u64 { '\n' as u64 } else { ch }
    }

    pub fn get_raw_byte(&self) -> u64 {
        while unsafe { self.lsr().read_volatile() } & LSR_DR == 0 {}
        let ch: u64 = unsafe { self.rbr().read_volatile() } as u64;
        ch
    }

    pub fn get_u32(&self) -> u32 {
        let mut num = 0u32;
        for i in 0..4u32 {
            num |= (self.getc() as u32 & 0xff) << (i << 3);
        }
        num
    }

    pub fn putc(&mut self, ch: u8) {
        if ch == b'\n' {
            self.putc(b'\r');
        }
        while unsafe { self.lsr().read_volatile() } & LSR_TDRQ == 0 {}
        unsafe { self.thr().write_volatile(ch) };
    }

    pub fn puts<T: AsRef<[u8]>>(&mut self, string: T) {
        for c in string.as_ref() {
            self.putc(*c);
        }
    }

    pub fn put_hex<T: Into<u64>>(&mut self, num: T) {
        self.puts("0x");
        let mut n: u64;
        let num_size = (size_of::<T>() << 1) - 1;
        let num = num.into();
        for c in { 0..=num_size }.rev() {
            let c1 = c << 2;
            n = (num >> c1) & 0xf;
            n += if n > 9 { 0x57 } else { b'0' as u64 };
            self.putc(n as u8);
        }
    }

    pub fn put_dec(&mut self, mut num: u64) {
        let mut num_str = [0u8; 64];
        let mut num_len = 0usize;
        if num == 0 {
            self.putc(b'0');
            return;
        }

        while num > 0 && num_len < num_str.len() {
            num_str[num_len] = b'0' + (num % 10) as u8;
            num /= 10;
            num_len += 1;
        }

        let num_str_slice = &mut num_str[..num_len];
        num_str_slice.reverse();
        self.puts(num_str_slice);
    }
}
